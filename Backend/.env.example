# ===========================================
# Local Development Environment Configuration
# ===========================================

# FastAPI Server Configuration
HOST=127.0.0.1
PORT=8000
RELOAD=true

# ===========================================
# Supabase Local Stack (PostgreSQL + Auth)
# ===========================================
# After running `supabase start`, use these connection details:

# Supabase PostgreSQL Database (Transactional Data)
SUPABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
SUPABASE_ANON_KEY=your_mock_anon_key_here
SUPABASE_SERVICE_KEY=your_mock_service_key_here

# Supabase API URL (for Auth and other services)
SUPABASE_API_URL=http://127.0.0.1:54321

# ===========================================
# MongoDB Local Instance (Catalog Data)
# ===========================================
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=al_madhina_catalog

# ===========================================
# Application Settings
# ===========================================
DEBUG=true
LOG_LEVEL=INFO

# JWT Secret (for custom auth if needed)
JWT_SECRET_KEY=your_local_development_jwt_secret_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
