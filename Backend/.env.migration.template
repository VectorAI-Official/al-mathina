# Environment Variables for Cloudinary Migration
# Copy this file to .env.migration and fill in your credentials

# ============================================
# OLD CLOUDINARY ACCOUNT (Source)
# ============================================
# The account you're migrating FROM
OLD_CLOUDINARY_CLOUD_NAME=your_old_cloud_name_here
OLD_CLOUDINARY_API_KEY=your_old_api_key_here
OLD_CLOUDINARY_API_SECRET=your_old_api_secret_here

# ============================================
# NEW CLOUDINARY ACCOUNT (Destination)
# ============================================
# The account you're migrating TO
NEW_CLOUDINARY_CLOUD_NAME=your_new_cloud_name_here
NEW_CLOUDINARY_API_KEY=your_new_api_key_here
NEW_CLOUDINARY_API_SECRET=your_new_api_secret_here

# ============================================
# OR USE PRODUCTION VARIABLES
# ============================================
# If you want to use your existing production credentials
# for the new account, just set these:
CLOUDINARY_CLOUD_NAME=your_new_cloud_name_here
CLOUDINARY_API_KEY=your_new_api_key_here
CLOUDINARY_API_SECRET=your_new_api_secret_here

# ============================================
# HOW TO FIND YOUR CREDENTIALS
# ============================================
# 1. Go to cloudinary.com
# 2. Log in to your account
# 3. Go to Dashboard
# 4. Find "Account Details" section
# 5. Copy: Cloud name, API Key, API Secret
#
# Repeat for both old and new accounts

# ============================================
# SECURITY NOTE
# ============================================
# Never commit this file with real credentials!
# Add .env.migration to .gitignore
